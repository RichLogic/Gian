strict-peer-dependencies=false
auto-install-peers=true
prefer-workspace-packages=true
link-workspace-packages=true
# Reject installs outside the pinned Node 24 LTS runtime (see root package.json
# engines). Keeping one Node ABI ensures better-sqlite3 is built for the same
# runtime used by Gian's packaged Host. engine-strict fails before install.
engine-strict=true
