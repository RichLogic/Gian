# Install as runtime.env on the server with mode 0600. Never commit real values.
GIAN_REMOTE_PUBLIC_ORIGIN=https://remote.example.com
GIAN_REMOTE_ALLOWED_ORIGINS=https://remote.example.com
GIAN_REMOTE_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_ADMIN_TOKEN
# Set only when the loopback reverse proxy overwrites trusted forwarding headers.
GIAN_REMOTE_TRUSTED_PROXY=1
