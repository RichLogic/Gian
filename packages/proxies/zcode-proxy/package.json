{
  "name": "@gian/zcode-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "com.zhipu.zcode — shared-scope Gian Proxy translating gian.proxy/2.1 over ZCode Protocol v1 (zcode.cjs app-server)",
  "type": "module",
  "main": "./dist/src/cli/spawn.js",
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/src/cli/spawn.js",
    "test": "pnpm run build && node --test 'dist/test/**/*.test.js'",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test:real-app-server": "pnpm run build && node --test dist/test/real-app-server-lifecycle.canary.js"
  },
  "dependencies": {
    "@gian/proxy-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.9.3"
  }
}
