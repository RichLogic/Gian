{
  "name": "@gian/codex-proxy",
  "version": "0.2.16",
  "private": true,
  "type": "module",
  "main": "./dist/src/cli/spawn.js",
  "gianProxy": { "releaseId": "codex", "shipping": true, "realAcceptance": { "binaryEnv": "CODEX_BIN", "proxyBinaryArg": "--codex-bin", "setup": "default" } },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/src/cli/spawn.js",
    "test": "pnpm run build && node --test dist/test/**/*.test.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@gian/proxy-protocol": "workspace:*",
    "@gian/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
