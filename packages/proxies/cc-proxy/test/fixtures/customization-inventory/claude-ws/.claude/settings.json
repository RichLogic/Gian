{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit*",
        "hooks": [
          { "type": "command", "command": "lint --fix --token ws-canary-tok" }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "prompt", "prompt": "Never reveal secrets" } ] }
    ]
  }
}
