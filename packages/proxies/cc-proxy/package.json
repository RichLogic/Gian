{
  "name": "@gian/cc-proxy",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "main": "./dist/src/cli/spawn.js",
  "gianProxy": { "releaseId": "claude", "shipping": true, "realAcceptance": { "binaryEnv": "CLAUDE_BIN", "setup": "claude-settings" } },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/src/cli/spawn.js",
    "test": "pnpm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "test:smoke": "pnpm run build && node --test dist/test/smoke.test.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@gian/proxy-protocol": "workspace:*",
    "@gian/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  }
}
