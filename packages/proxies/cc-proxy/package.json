{
  "name": "@gian/cc-proxy",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/cli/spawn.js",
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/src/cli/spawn.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@gian/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  }
}
