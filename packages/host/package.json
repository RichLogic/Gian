{
  "name": "@gian/host",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "pnpm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx --test-reporter spec test/*.test.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "postinstall": "node scripts/fix-node-pty-permissions.cjs"
  },
  "dependencies": {
    "@gian/proxy-catalog-contract": "workspace:*",
    "@gian/proxy-protocol": "workspace:*",
    "@gian/remote-protocol": "workspace:*",
    "@gian/shared": "workspace:*",
    "@gian/tool-mcp": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/node-ws": "^1.0.5",
    "better-sqlite3": "13.0.3",
    "croner": "10.0.1",
    "hono": "^4.12.34",
    "node-pty": "^1.1.0-beta40",
    "semver": "7.7.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@gian/cc-proxy": "workspace:*",
    "@gian/codex-proxy": "workspace:*",
    "@gian/dsh-bridge": "workspace:*",
    "@gian/dsh-proxy": "workspace:*",
    "@gian/kimi-proxy": "workspace:*",
    "@gian/grok-proxy": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/semver": "7.7.1",
    "tsx": "^4.19.2"
  }
}
