{
  "name": "@gian/desktop",
  "productName": "Gian",
  "version": "0.5.1",
  "private": true,
  "description": "macOS desktop shell for the Gian coding agent workspace",
  "author": "RichLogic",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "test:smoke": "pnpm run build && pnpm run test:smoke:run",
    "test:smoke:run": "node test/electron-smoke.mjs",
    "dev": "pnpm run build && electron .",
    "start": "electron .",
    "bundle:build": "node ../../scripts/prepare-desktop-runtime.mjs && pnpm --filter @gian/dsh-bridge build && pnpm --filter @gian/desktop... build && pnpm --filter @gian/web build",
    "package:mac": "pnpm run bundle:build && electron-builder --mac dir --arm64 --publish never",
    "make:mac": "pnpm run bundle:build && electron-builder --mac dmg zip --arm64 --publish never",
    "make:mac:release": "node -e \"for (const name of ['CSC_LINK','CSC_KEY_PASSWORD','APPLE_API_KEY','APPLE_API_KEY_ID','APPLE_API_ISSUER','GIAN_GITHUB_CLIENT_ID']) if (!process.env[name]) throw new Error('Missing release environment: ' + name)\" && pnpm run bundle:build && electron-builder --mac dmg zip --arm64 --config.forceCodeSigning=true --config.mac.notarize=true --config.extraMetadata.gianReleaseChannel=stable --publish never && pnpm run verify:update-artifacts",
    "verify:update-artifacts": "node ../../scripts/verify-update-artifacts.mjs --release-dir release --version $npm_package_version",
    "clean": "rm -rf dist release *.tsbuildinfo"
  },
  "dependencies": {
    "@gian/host": "workspace:*",
    "@gian/shared": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2"
  },
  "build": {
    "appId": "com.gian.desktop",
    "productName": "Gian",
    "asar": true,
    "artifactName": "Gian-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../proxies/dsh-bridge",
        "to": "dsh-bridge",
        "filter": [
          "package.json",
          "cordis.patch.yml",
          "dist/src/**/*.js"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "binaries": [
        "Contents/Resources/runtime/node"
      ]
    },
    "dmg": {
      "title": "Gian ${version}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RichLogic",
        "repo": "Gian",
        "private": false,
        "channel": "latest",
        "releaseType": "release",
        "publishAutoUpdate": true
      }
    ]
  }
}
