{
  "name": "@gian/desktop",
  "productName": "Gian",
  "version": "0.2.0",
  "private": true,
  "description": "macOS desktop shell for the Gian coding agent workspace",
  "author": "RichLogic",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "test:smoke": "pnpm run build && node test/electron-smoke.mjs",
    "dev": "pnpm run build && electron .",
    "start": "electron .",
    "bundle:build": "pnpm --filter @gian/desktop... build && pnpm --filter @gian/web build && node ../../scripts/prepare-desktop-runtime.mjs",
    "package:mac": "pnpm run bundle:build && electron-builder --mac dir --arm64",
    "make:mac": "pnpm run bundle:build && electron-builder --mac dmg zip --arm64",
    "make:mac:release": "pnpm run bundle:build && electron-builder --mac dmg zip --arm64 --config.mac.notarize=true",
    "clean": "rm -rf dist release *.tsbuildinfo"
  },
  "dependencies": {
    "@gian/host": "workspace:*",
    "@gian/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.49.0",
    "tsx": "^4.19.2"
  },
  "build": {
    "appId": "com.gian.desktop",
    "productName": "Gian",
    "asar": true,
    "artifactName": "Gian-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "binaries": [
        "Contents/Resources/runtime/node"
      ]
    },
    "dmg": {
      "title": "Gian ${version}"
    }
  }
}
