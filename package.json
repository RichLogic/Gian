{
  "name": "gian",
  "version": "0.4.0",
  "private": true,
  "description": "One local desktop app for Codex, Claude Code, and Kimi Code",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "build": "pnpm -r build",
    "dev": "node scripts/dev.mjs",
    "dev:up": "node scripts/dev.mjs up",
    "dev:open": "node scripts/dev.mjs open",
    "dev:chrome": "node scripts/dev.mjs chrome",
    "dev:status": "node scripts/dev.mjs status",
    "dev:restart": "node scripts/dev.mjs restart",
    "dev:down": "node scripts/dev.mjs down",
    "dev:web": "node scripts/dev.mjs up",
    "typecheck": "pnpm -F @gian/shared build && pnpm -r typecheck",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "pnpm -r build && node scripts/run-e2e.mjs",
    "test:e2e:run": "node scripts/run-e2e.mjs",
    "desktop:dev": "node scripts/dev.mjs open",
    "desktop:pack": "pnpm -F @gian/desktop package:mac",
    "desktop:dmg": "pnpm -F @gian/desktop make:mac",
    "release:proxies": "pnpm --filter @gian/shared build && pnpm --filter @gian/cc-proxy build && pnpm --filter @gian/codex-proxy build && pnpm --filter @gian/kimi-proxy build && node scripts/build-proxy-artifacts.mjs",
    "quality:traceability": "node scripts/check-traceability.js",
    "quality:docs": "node scripts/check-doc-links.mjs",
    "quality:audit:prod": "pnpm audit --prod --audit-level=high",
    "quality:operations": "node scripts/check-ui-operations.mjs",
    "quality:prepackage": "node scripts/run-quality-prepackage.mjs",
    "quality:package": "node scripts/run-quality-package.mjs",
    "quality:package:smoke": "node scripts/run-packaged-app-smoke.mjs",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.2"
  }
}
