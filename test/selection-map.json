{
  "version": 1,
  "stages": {
    "quick": {
      "runScopes": [
        "unit",
        "integration"
      ]
    },
    "merge": {
      "runScopes": [
        "unit",
        "integration",
        "system"
      ]
    }
  },
  "rules": [
    {
      "id": "proxy-information-projection",
      "patterns": ["catalog/proxy-information/**"],
      "modules": ["scripts", "proxy-catalog-contract"],
      "scopes": ["integration", "unit"],
      "checks": ["quality:test-catalog"],
      "reason": "Authored Proxy tutorials and histories project to signed v1-compatible Catalog documents."
    },
    {
      "id": "proxy-protocol-delivery",
      "patterns": ["delivery/proxies/**", "scripts/export-proxies.mjs", "scripts/proxies-delivery.test.mjs", "scripts/proxy-protocol-package.mjs", "scripts/proxy-protocol-package.test.mjs", "scripts/import-proxy-protocol.mjs", "scripts/fixtures/proxy-protocol-consumer.mts", ".github/workflows/proxy-protocol-release.yml"],
      "modules": ["proxy-protocol", "scripts"],
      "scopes": ["unit", "integration", "system"],
      "checks": ["typecheck", "quality:test-catalog"],
      "reason": "Public Proxy Protocol delivery binds the standalone consumer to immutable public package bytes."
    },
    {
      "id": "remote-delivery",
      "patterns": ["delivery/remote/**", "scripts/export-remote.mjs", "scripts/remote-delivery.test.mjs", "scripts/remote-deployment-system.test.mjs", "scripts/remote-protocol-package.mjs", "scripts/remote-protocol-package.test.mjs", "scripts/import-remote-protocol.mjs"],
      "modules": ["remote-protocol", "remote-server", "remote-web", "chat-ui", "scripts"],
      "scopes": ["unit", "integration", "system"],
      "checks": ["typecheck", "quality:test-catalog"],
      "reason": "Remote export and delivery changes affect its independent build, artifact integrity and deployment boundary."
    },
    {
      "id": "root-test-infrastructure",
      "patterns": [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "test/*.json",
        "test/e2e/**",
        "playwright.config.ts",
        "playwright.remote-acceptance.config.mjs",
        "scripts/run-giandev-acceptance.mjs",
        "scripts/run-tests.mjs",
        "scripts/test-catalog.mjs",
        "scripts/run-affected-tests.mjs",
        "scripts/test-selection.mjs",
        "scripts/local-verification.mjs",
        "scripts/execution-policy.mjs",
        "scripts/run-verification.mjs",
        "scripts/typecheck.mjs",
        ".github/workflows/*.yml"
      ],
      "modules": [
        "cc-proxy",
        "codex-proxy",
        "desktop",
        "dsh-bridge",
        "dsh-proxy",
        "grok-proxy",
        "host",
        "kimi-proxy",
        "proxy-catalog-contract",
        "proxy-protocol",
        "scripts",
        "shared",
        "tool-cli",
        "tool-mcp",
        "web",
        "zcode-proxy",
        "chat-ui",
        "remote-protocol",
        "remote-server",
        "remote-web"
      ],
      "scopes": [
        "unit",
        "integration",
        "system"
      ],
      "checks": [
        "typecheck",
        "quality:test-catalog",
        "quality:test-selection",
        "quality:functional-evidence",
        "quality:docs",
        "quality:operations:strict",
        "quality:versions"
      ],
      "reason": "Root build, catalog, runner, or CI changes can alter every deterministic test path."
    },
    {
      "id": "quality-docs",
      "patterns": [
        "*.md",
        "docs/archive/**",
        "docs/**/*.md",
        ".agents/skills/**",
        "AGENTS.md",
        "CLAUDE.md",
        "docs/mockups/**",
        "design/**"
      ],
      "optionalPatterns": [
        "docs/archive/**",
        "docs/**/*.md",
        ".agents/skills/**",
        "AGENTS.md",
        "CLAUDE.md",
        "docs/mockups/**",
        "design/**"
      ],
      "modules": [],
      "scopes": [],
      "checks": [
        "quality:docs"
      ],
      "reason": "Documentation and historical snapshots need valid active links, not product regression or a manual ledger."
    },
    {
      "id": "scripts",
      "patterns": [
        "scripts/**"
      ],
      "modules": [
        "scripts"
      ],
      "scopes": [
        "unit",
        "integration",
        "system"
      ],
      "checks": [
        "typecheck"
      ],
      "reason": "Repository automation changes select the script regression surface."
    },
    {
      "id": "shared-contract",
      "patterns": [
        "packages/shared/**"
      ],
      "modules": [
        "cc-proxy",
        "codex-proxy",
        "desktop",
        "dsh-bridge",
        "dsh-proxy",
        "grok-proxy",
        "host",
        "kimi-proxy",
        "proxy-protocol",
        "shared",
        "web",
        "zcode-proxy",
        "chat-ui"
      ],
      "scopes": [
        "unit",
        "integration",
        "system"
      ],
      "checks": [
        "typecheck"
      ],
      "reason": "Shared contracts are consumed by the Host, UI, Desktop, and all proxies."
    },
    {
      "id": "proxy-protocol-contract",
      "patterns": [
        "packages/proxy-protocol/**"
      ],
      "modules": [
        "cc-proxy",
        "codex-proxy",
        "dsh-proxy",
        "grok-proxy",
        "host",
        "kimi-proxy",
        "proxy-protocol",
        "zcode-proxy"
      ],
      "scopes": [
        "unit",
        "integration",
        "system"
      ],
      "checks": [
        "typecheck"
      ],
      "reason": "Proxy protocol changes expand to every proxy consumer and Host routing."
    },
    {
      "id": "proxy-catalog-contract",
      "patterns": [
        "packages/proxy-catalog-contract/**"
      ],
      "modules": [
        "proxy-catalog-contract"
      ],
      "scopes": [
        "unit"
      ],
      "checks": [
        "typecheck"
      ],
      "reason": "Official Catalog Source/Bundle contract changes stay at the isolated contract package."
    },
    {
      "id": "official-catalog-source",
      "patterns": [
        "catalog/official-source/**",
        "scripts/compile-official-catalog.mjs",
        "scripts/verify-official-catalog-source.mjs"
      ],
      "modules": [
        "proxy-catalog-contract",
        "host"
      ],
      "scopes": [
        "unit",
        "integration"
      ],
      "checks": [
        "typecheck",
        "catalog:verify"
      ],
      "reason": "Official Catalog source and compile/verify scripts must stay mapped; unknown-path full-suite fallback is forbidden."
    },
    {
      "id": "proxy-step-request-trace",
      "patterns": [
        "packages/proxy-protocol/src/constants.ts",
        "packages/proxy-protocol/src/schemas.ts",
        "packages/proxy-protocol/src/conformance.ts",
        "packages/shared/src/trace.ts",
        "packages/host/src/trace/**",
        "packages/host/src/event/project-protocol-v2.ts",
        "packages/web/src/trace/**",
        "scripts/fixtures/fake-catalog-ui-proxy.mjs"
      ],
      "modules": [
        "proxy-protocol",
        "shared",
        "host",
        "web"
      ],
      "scopes": [
        "unit",
        "integration",
        "system"
      ],
      "checks": [
        "typecheck",
        "quality:operations:strict"
      ],
      "reason": "Step/request protocol identities cross the canonical evidence, Trace projection, and Web hierarchy boundaries."
    },
    {
      "id": "host",
      "patterns": [
        "packages/host/**"
      ],
      "modules": [
        "host",
        "web"
      ],
      "scopes": [
        "unit",
        "integration"
      ],
      "checks": [
        "typecheck"
      ],
      "reason": "Host behavior selects Host tests plus Web contract and component integration."
    },
