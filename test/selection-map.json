        "docs/adr/0049-inject-session-scoped-gian-mcp.md",
        "docs/adr/0050-create-view-only-worktrees-through-gian-tool.md",
        "docs/operations/gian-tool-v0-api-and-implementation.md"
      ],
      "modules": [
        "shared",
        "host",
        "tool-cli",
        "tool-mcp",
        "proxy-protocol",
        "codex-proxy",
        "web"
      ],
      "scopes": [
        "unit",
        "integration",
        "system"
      ],
      "checks": [
