{
  "version": 1,
  "protocol": "gian.proxy/2.1",
  "description": "Real Provider acceptance catalog for every Proxy behavior implemented in Gian 0.5.2.",
  "resultSchemas": {
    "initialize": "initializeResultSchema",
    "catalog.list": "catalogResultSchema",
    "catalog.resolve": "catalogResolveResultSchema",
    "session.create": "sessionCreateResultSchema",
    "session.get": "sessionGetResultSchema",
    "session.rename": "okResultSchema",
    "session.native.list": "nativeSessionListResultSchema",
    "session.native.delete": "okResultSchema",
    "session.replay": "replayResultSchema",
    "sidechat.create": "sidechatResultSchema",
    "sidechat.resume": "sidechatResultSchema",
    "sidechat.close": "sidechatCloseResultSchema",
    "session.fork": "sessionForkResultSchema",
    "turn.start": "turnStartResultSchema",
    "turn.interrupt": "turnControlResultSchema",
    "turn.steer": "turnControlResultSchema",
    "interaction.respond": "interactionRespondResultSchema",
    "session.close": "okResultSchema",
    "shutdown": "okResultSchema"
  },
  "notificationSchemas": {
    "turn.started": {
      "scope": "turn",
      "required": ["eventId", "streamId", "sequence", "sessionId", "turnId", "sourceTurnId", "emittedAt", "data"]
    },
    "input.recorded": {
      "scope": "turn",
      "required": ["eventId", "streamId", "sequence", "sessionId", "turnId", "sourceTurnId", "emittedAt", "data.input"]
    },
    "content.delta": {
      "scope": "turn",
      "required": ["eventId", "streamId", "sequence", "sessionId", "turnId", "sourceTurnId", "emittedAt", "data.contentId", "data.kind", "data.delta"]
    },
    "content.completed": {
      "scope": "turn",
      "required": ["eventId", "streamId", "sequence", "sessionId", "turnId", "sourceTurnId", "emittedAt", "data.contentId", "data.kind"]
    },
    "session.updated": {
      "scope": "session",
      "required": ["eventId", "streamId", "sequence", "sessionId", "emittedAt", "data"]
    },
    "turn.completed": {
      "scope": "turn",
      "required": ["eventId", "streamId", "sequence", "sessionId", "turnId", "sourceTurnId", "emittedAt", "data.stopReason"]
    },
    "turn.failed": {
      "scope": "turn",
      "required": ["eventId", "streamId", "sequence", "sessionId", "turnId", "sourceTurnId", "emittedAt", "data.error.domainCode", "data.error.message", "data.error.retryable"]
    },
    "runtime.error": {
      "scope": "session_or_process",
      "required": ["eventId", "emittedAt", "data.domainCode", "data.message", "data.retryable"],
      "conditional": ["session scope additionally requires streamId, sequence and sessionId"]
    },
    "activity.updated": {
      "scope": "turn",
      "required": ["eventId", "streamId", "sequence", "sessionId", "turnId", "sourceTurnId", "emittedAt", "data.activityId", "data.kind", "data.title", "data.status", "data.presentation.type"]
    },
    "step.updated": {
      "scope": "turn",
      "required": ["eventId", "streamId", "sequence", "sessionId", "turnId", "sourceTurnId", "emittedAt", "data.stepId", "data.index", "data.status"]
    },
    "request.updated": {
      "scope": "turn",
      "required": ["eventId", "streamId", "sequence", "sessionId", "turnId", "sourceTurnId", "emittedAt", "data.requestId", "data.reason"]
    },
    "interaction.requested": {
      "scope": "turn",
      "required": ["eventId", "streamId", "sequence", "sessionId", "turnId", "sourceTurnId", "emittedAt", "data.interactionId", "data.title", "data.presentation.kind", "data.inputs", "data.actions"]
    },
    "interaction.resolved": {
      "scope": "turn",
      "required": ["eventId", "streamId", "sequence", "sessionId", "turnId", "sourceTurnId", "emittedAt", "data.interactionId", "data.outcome"]
    },
    "plan.updated": {
      "scope": "turn",
      "required": ["eventId", "streamId", "sequence", "sessionId", "turnId", "sourceTurnId", "emittedAt", "data.planId", "data.title", "data.steps"]
    },
    "diff.updated": {
      "scope": "turn",
      "required": ["eventId", "streamId", "sequence", "sessionId", "turnId", "sourceTurnId", "emittedAt", "data.diffId", "data.diff", "data.truncated"]
    },
    "usage.updated": {
      "scope": "turn_or_session",
      "required": ["eventId", "streamId", "sequence", "sessionId", "emittedAt", "data"]
    },
    "catalog.changed": {
      "scope": "process",
      "required": ["eventId", "emittedAt", "data.reason", "data.revision"]
    },
    "history.changed": {
      "scope": "session",
      "required": ["eventId", "streamId", "sequence", "sessionId", "emittedAt", "data.reason", "data.revision"]
    }
  },
  "globalInvariants": [
    "Every stdout line is one UTF-8 JSON-RPC 2.0 object and at most 16 MiB.",
    "A request response is written before notifications caused by that request.",
    "Notification sequence is contiguous within one attached stream.",
    "eventId is unique within a live stream.",
    "Host sessionId and turnId are preserved exactly.",
    "Every turn has exactly one terminal notification.",
    "interrupted is emitted only after an accepted Host interrupt.",
    "Every running activity and step is terminal before the turn terminal.",
    "Interaction responseId is idempotent and actionId is returned unchanged.",
    "Events requiring a capability never appear unless initialize advertised it.",
    "The same Provider fact keeps sourceTurnId and event identity across live and replay."
  ],
