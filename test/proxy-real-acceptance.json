  "scenarios": [
    {
      "id": "transport.initialize_catalog",
      "category": "transport",
      "trigger": "control",
      "purpose": "Negotiate identity, process scope, capabilities, inputs, config bindings and current runtime catalog without a model turn.",
      "methods": ["initialize", "catalog.list"],
      "notifications": [],
      "steps": ["start proxy", "initialize", "catalog.list", "record runtime and catalog snapshot"],
      "providers": {"claude":"required","codex":"required","kimi":"required","grok":"required","dsh":"required","zcode":"required"}
    },
    {
      "id": "transport.invalid_frames",
      "category": "transport",
      "trigger": "control",
      "purpose": "Differentiate parse error, invalid request, invalid params and unknown method without touching a Provider turn.",
      "methods": ["initialize"],
      "notifications": [],
      "steps": ["send malformed JSON", "send a batch", "send an unknown method", "send invalid params", "assert numeric JSON-RPC codes and stable domainCode"],
      "providers": {"claude":"required","codex":"required","kimi":"required","grok":"required","dsh":"required","zcode":"required"}
    },
    {
      "id": "catalog.resolve",
      "category": "catalog",
      "trigger": "control",
      "purpose": "Resolve dependent defaults only where the Proxy advertises catalog.resolve.",
      "methods": ["catalog.resolve"],
      "notifications": [],
      "steps": ["send current catalog revision", "resolve cheapest valid config", "send stale revision", "send invalid config"],
      "providers": {"claude":"required","codex":"unsupported","kimi":"unsupported","grok":"unsupported","dsh":"required","zcode":"required"}
    },
    {
      "id": "config.validation",
      "category": "catalog",
      "trigger": "control",
      "purpose": "Reject unknown, wrong-bound and invalid choice values before Provider side effects.",
      "methods": ["session.create", "turn.start"],
      "notifications": [],
      "steps": ["send unknown session config", "send turn option during session.create", "send session option during turn.start", "send invalid choice"],
      "providers": {"claude":"required","codex":"required","kimi":"required","grok":"required","dsh":"required","zcode":"required"}
    },
    {
      "id": "session.lifecycle",
      "category": "session",
      "trigger": "control",
      "purpose": "Create, get, idempotently recreate, rename and close one attached Session.",
      "methods": ["session.create", "session.get", "session.rename", "session.close"],
      "notifications": ["session.updated"],
      "steps": ["session.create", "session.get", "repeat identical create", "reuse id with conflicting params", "rename", "close twice"],
      "providers": {"claude":"required","codex":"required","kimi":"required","grok":"required","dsh":"partial","zcode":"partial"}
    },
    {
      "id": "input.local_file",
      "category": "input",
      "trigger": "real_prompt",
      "purpose": "Send a deterministic local file reference through every Proxy that advertises it.",
      "methods": ["turn.start"],
      "notifications": ["turn.started", "content.delta", "content.completed", "turn.completed"],
      "prompt": "Read the attached file. Reply with exactly the unique marker found inside it and nothing else.",
      "steps": ["create marker.txt fixture", "attach localFile", "start turn", "wait for terminal"],
      "providers": {"claude":"required","codex":"unsupported","kimi":"required","grok":"required","dsh":"contract_only","zcode":"spec_gap"}
    },
    {
      "id": "input.local_image",
      "category": "input",
      "trigger": "real_prompt",
      "purpose": "Send a deterministic image through every Proxy that advertises localImage.",
      "methods": ["turn.start"],
      "notifications": ["turn.started", "content.delta", "content.completed", "turn.completed"],
      "prompt": "Inspect the attached image. Reply with exactly the large uppercase word shown in it and nothing else.",
      "steps": ["create a local PNG with one marker word", "attach localImage", "start turn", "wait for terminal"],
      "providers": {"claude":"required","codex":"required","kimi":"required","grok":"required","dsh":"contract_only","zcode":"spec_gap"}
    },
    {
      "id": "input.skill",
      "category": "input",
      "trigger": "real_prompt",
      "purpose": "Pass a typed skill item without flattening it into ordinary text.",
      "methods": ["turn.start"],
      "notifications": ["turn.started", "content.delta", "content.completed", "turn.completed"],
      "prompt": "Use the attached acceptance skill. Reply with exactly PROXY_SKILL_OK.",
      "steps": ["create a minimal SKILL.md fixture", "attach skill input", "start turn", "wait for terminal"],
      "providers": {"claude":"unsupported","codex":"required","kimi":"unsupported","grok":"unsupported","dsh":"unsupported","zcode":"unsupported"}
    },
    {
      "id": "turn.basic_content_reasoning_usage",
      "category": "turn",
      "trigger": "real_prompt",
      "purpose": "Observe the normal text, reasoning, usage, session-state and terminal event family.",
      "methods": ["turn.start"],
      "notifications": ["turn.started", "content.delta", "content.completed", "usage.updated", "turn.completed"],
      "prompt": "Think briefly about whether 17 is prime, then reply with exactly PRIME_17_OK. Do not use tools.",
      "steps": ["create session with cheapest config", "start turn", "wait for exactly one terminal", "record optional reasoning stream"],
      "providers": {"claude":"required","codex":"required","kimi":"required","grok":"required","dsh":"required","zcode":"required"}
    },
    {
      "id": "activity.workspace_tools",
      "category": "activity",
      "trigger": "real_prompt",
      "purpose": "Exercise real workspace read, search, write, rename, delete and command execution through Provider tools.",
      "methods": ["turn.start", "interaction.respond"],
      "notifications": ["activity.updated", "content.completed", "turn.completed"],
      "prompt": "Perform every step using tools: (1) read source.txt, (2) search the workspace for ACCEPTANCE_NEEDLE, (3) create draft.txt containing TOOL_FLOW_OK, (4) rename it to final.txt, (5) create then delete obsolete.txt, and (6) run `node verify.mjs`. Finish only after the command succeeds, then reply exactly TOOL_FLOW_OK.",
      "steps": ["prepare isolated workspace fixtures", "start turn in ask mode", "respond to every safe workspace approval", "verify filesystem outcome", "wait for terminal"],
      "providers": {"claude":"required","codex":"required","kimi":"required","grok":"required","dsh":"not_run","zcode":"required"}
    },
    {
      "id": "activity.plan",
      "category": "activity",
      "trigger": "real_prompt",
      "purpose": "Observe a Provider-native plan snapshot without fabricating Gian plan events.",
      "methods": ["turn.start"],
      "notifications": ["plan.updated", "turn.completed"],
      "prompt": "Use your native plan or todo update tool to create exactly two steps. Mark the first step complete and the second in progress, read source.txt, then mark both complete. Do not merely describe a plan in prose. Finally reply exactly PLAN_FLOW_OK.",
      "steps": ["select the Provider plan-capable mode when required", "start turn", "wait for plan.updated", "wait for terminal"],
      "providers": {"claude":"unsupported","codex":"required","kimi":"required","grok":"required","dsh":"unsupported","zcode":"unsupported"}
    },
    {
      "id": "activity.diff",
      "category": "activity",
      "trigger": "real_prompt",
      "purpose": "Observe a schema-valid unified diff emitted by a Provider that advertises event.diff.",
      "methods": ["turn.start", "interaction.respond"],
      "notifications": ["activity.updated", "diff.updated", "turn.completed"],
      "prompt": "Edit change-me.txt, replacing BEFORE_ACCEPTANCE with AFTER_ACCEPTANCE. Use the normal file-edit tool and then reply exactly DIFF_FLOW_OK.",
      "steps": ["prepare change-me.txt", "start turn", "approve workspace edit", "verify diff and file", "wait for terminal"],
      "providers": {"claude":"unsupported","codex":"required","kimi":"unsupported","grok":"required","dsh":"contract_only","zcode":"unsupported"}
    },
    {
      "id": "activity.subagent",
      "category": "activity",
      "trigger": "real_prompt",
      "purpose": "Observe the complete subagent activity lifecycle where the production runtime can actually invoke one.",
      "methods": ["turn.start"],
      "notifications": ["activity.updated", "turn.completed"],
      "prompt": "Delegate to exactly one subagent. Ask it to read subagent.txt and return its unique marker. Wait for it, then reply exactly SUBAGENT_FLOW_OK.",
      "steps": ["prepare subagent fixture", "enable native collaboration when required", "start turn", "wait for running and terminal agent activity", "wait for turn terminal"],
      "providers": {"claude":"required","codex":"conditional","kimi":"unsupported","grok":"policy_blocked","dsh":"contract_only","zcode":"unsupported"}
    },
    {
      "id": "activity.notice_unknown",
      "category": "activity",
      "trigger": "fault_fixture",
      "purpose": "Preserve unknown visible Provider events as diagnostic activities and filter only explicit noise.",
      "methods": ["turn.start"],
      "notifications": ["activity.updated", "turn.completed"],
      "steps": ["inject one known-hidden event", "inject one unknown visible event", "assert only the visible event degrades to generic activity"],
      "providers": {"claude":"fake_only","codex":"fake_only","kimi":"fake_only","grok":"fake_only","dsh":"fake_only","zcode":"fake_only"}
    },
    {
      "id": "interaction.permission",
      "category": "interaction",
      "trigger": "real_prompt",
      "purpose": "Round-trip every native permission action without Gian interpreting opaque action IDs.",
      "methods": ["turn.start", "interaction.respond"],
      "notifications": ["interaction.requested", "interaction.resolved", "turn.completed"],
      "prompt": "Use a tool that requires approval to write permission.txt with PERMISSION_FLOW_OK. Do not avoid the requested write.",
      "steps": ["start turn in ask mode", "capture native actions", "choose one safe allow action", "respond with a unique responseId", "repeat identical response", "wait for resolved and terminal"],
      "providers": {"claude":"required","codex":"required","kimi":"required","grok":"required","dsh":"contract_only","zcode":"required"}
    },
    {
      "id": "interaction.question",
      "category": "interaction",
      "trigger": "real_prompt",
      "purpose": "Trigger a native question interaction, return structured values and preserve response ordering.",
      "methods": ["turn.start", "interaction.respond"],
      "notifications": ["interaction.requested", "interaction.resolved", "turn.completed"],
      "prompt": "Before doing any work, use your native user-question tool to ask which marker to write. Offer ALPHA and BETA when the runtime supports choices. After the answer, write the selected marker and finish.",
      "steps": ["start turn", "wait for question interaction", "supply ALPHA", "assert response before resolved", "wait for terminal"],
      "providers": {"claude":"required","codex":"required","kimi":"conditional","grok":"unsupported","dsh":"contract_only","zcode":"unsupported"}
    },
    {
      "id": "interaction.exit_plan_confirmation",
      "category": "interaction",
      "trigger": "real_prompt",
      "purpose": "Exercise the Provider's exit-plan confirmation and all advertised actions.",
      "methods": ["turn.start", "interaction.respond"],
      "notifications": ["interaction.requested", "interaction.resolved", "turn.completed"],
      "prompt": "Enter native planning mode, produce a short plan, then invoke the native exit-plan operation and wait for the user's decision.",
      "steps": ["start in plan mode", "wait for exit-plan interaction", "record every action", "choose the continue action", "wait for resolved and terminal"],
      "providers": {"claude":"spec_gap","codex":"unsupported","kimi":"conditional","grok":"unsupported","dsh":"unsupported","zcode":"unsupported"}
    },
    {
      "id": "control.steer",
      "category": "control",
      "trigger": "real_control",
      "purpose": "Send same-turn input while a Provider turn remains active.",
      "methods": ["turn.start", "turn.steer"],
      "notifications": ["turn.started", "content.delta", "content.completed", "turn.completed"],
      "prompt": "Draft a long explanation in at least eight paragraphs. Do not use tools and do not finish early.",
      "steps": ["start long turn", "wait for turn.started", "steer with a unique marker instruction", "assert accepted turnId", "verify one terminal and steered marker"],
      "providers": {"claude":"unsupported","codex":"required","kimi":"unsupported","grok":"required","dsh":"unsupported","zcode":"unsupported"}
    },
    {
      "id": "control.interrupt_busy",
      "category": "control",
      "trigger": "real_control",
      "purpose": "Reject a second turn while busy, accept Host interrupt and emit exactly one interrupted terminal.",
      "methods": ["turn.start", "turn.interrupt"],
      "notifications": ["turn.started", "turn.completed"],
      "prompt": "Run `node long-running.mjs` and wait for it to finish before replying.",
      "steps": ["start long command turn", "attempt a second turn and expect SESSION_BUSY", "interrupt active turn", "assert response before terminal", "assert stopReason interrupted"],
      "providers": {"claude":"required","codex":"required","kimi":"required","grok":"required","dsh":"contract_only","zcode":"required"}
    },
    {
      "id": "concurrency.process_scope",
      "category": "control",
      "trigger": "real_control",
      "purpose": "Verify shared Proxies isolate concurrent Sessions and session-scoped Proxies isolate processes.",
      "methods": ["session.create", "turn.start", "turn.interrupt", "session.close"],
      "notifications": ["turn.started", "content.completed", "turn.completed"],
      "steps": ["create two sessions", "start two marked turns", "interrupt one", "assert the other completes unaffected"],
      "providers": {"claude":"session_scope","codex":"required","kimi":"required","grok":"session_scope","dsh":"required","zcode":"required"}
    },
    {
      "id": "native.discovery_replay_identity",
      "category": "replay",
      "trigger": "real_control",
      "purpose": "Discover the completed native Session, replay it and compare sourceTurnId/event identity with live facts.",
